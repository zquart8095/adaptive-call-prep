# All optional — the demo runs fully without any of these set.

# Output mode: "local" (default, writes markdown/json under output/) or "gdocs"
OUTPUT_MODE=local

# Only needed for OUTPUT_MODE=gdocs. Path to an OAuth Desktop-app client
# credentials file (Docs + Drive API scopes). See README "Google Docs setup".
GOOGLE_DOCS_CREDENTIALS_PATH=

# Only needed to enable real LLM synthesis. Without it, sections are
# synthesized deterministically via string templates (still runnable,
# just less prose-like).
ANTHROPIC_API_KEY=

# Optional LangSmith tracing + eval feedback (see README "Operationalizing
# eval with LangSmith"). BOTH vars are required — the API key alone does
# NOT turn tracing on, a real LangSmith gotcha, not specific to this repo.
# Get a free key at smith.langchain.com under Settings > API Keys.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=

# Required for `sales-prep chat` only (see README "Chat: conversational RAG
# over collected data") — this one feature is NOT zero-setup by design, it
# uses real vector embeddings, not a keyword-matching fallback. Get a free
# key at dash.voyageai.com.
VOYAGE_API_KEY=
